<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <DalamudLib Condition="'$(DalamudLib)' == ''">$(HOME)/.xlcore/dalamud/Hooks/dev</DalamudLib>
    <AssemblyName>RepoCheck</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Dalamud"><HintPath>$(DalamudLib)/Dalamud.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(DalamudLib)/Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="FFXIVClientStructs"><HintPath>$(DalamudLib)/FFXIVClientStructs.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(DalamudLib)/InteropGenerator.Runtime.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
